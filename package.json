{
  "name": "peticim-api",
  "version": "1.0.4",
  "description": "Peticim app API",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Testler Firestore emülatörü gerektirir: npm run test:emu\" && exit 1",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test:emu": "firebase emulators:exec --only firestore --project demo-peticim --config ../firebase.json \"node --experimental-test-module-mocks --test --test-concurrency=1 \\\"test/*.test.js\\\"\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peticim/Peticim-API.git"
  },
  "author": "Zecky-dev",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.11.0",
    "cloudinary": "^2.7.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^13.5.0",
    "geofire-common": "^6.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
